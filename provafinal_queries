-- Análise Demográfica e Socioeconômica dos Clientes por País

WITH PerfilClientes AS (
	SELECT
		g.RegionCountryName AS Pais,

    CASE
        WHEN c.Gender = 'M' THEN 'Masculino'
        WHEN c.Gender = 'F' THEN 'Feminino'
        ELSE 'Não Informado'
    END AS Genero,

    CASE
        WHEN c.MaritalStatus = 'M' THEN 'Casado'
        WHEN c.MaritalStatus = 'S' THEN 'Solteiro'
        ELSE 'Não Informado'
    END AS EstadoCivil,

    CASE
        WHEN c.YearlyIncome < 30000 THEN 'Baixa Renda'
        WHEN c.YearlyIncome BETWEEN 30000 AND 70000 THEN 'Média Renda'
        ELSE 'Alta Renda'
    END AS FaixaRenda

    FROM DimCustomer c
    JOIN DimGeography g ON c.GeographyKey = g.GeographyKey)

SELECT
    Pais,
    Genero,
    EstadoCivil,
    FaixaRenda,
    COUNT(*) AS QuantidadeClientes,
    CAST(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER(PARTITION BY Pais) AS DECIMAL(5,2)) AS PercentualNoPais

FROM PerfilClientes

GROUP BY
    Pais, Genero, EstadoCivil, FaixaRenda

ORDER BY
    QuantidadeClientes DESC, Pais
